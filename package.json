{
  "name": "my-hugo-site",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/tailwind.css -o ./static/css/tailwind.css --minify",
    "dev": "concurrently --kill-others --names css,hugo --prefix-colors cyan,magenta \"npm:watch:css\" \"hugo server -D\"",
    "watch:css": "tailwindcss -i ./assets/css/tailwind.css -o ./static/css/tailwind.css --watch=always"
  },
